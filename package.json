{
  "name": "hookline",
  "version": "1.0.0",
  "description": "Self-hosted webhook and API request inspector. Capture any HTTP request to a unique URL, inspect it, replay it, and copy it as cURL, JavaScript, Python or raw HTTP.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "webhook",
    "webhooks",
    "request-inspector",
    "request-logger",
    "webhook-tester",
    "webhook-receiver",
    "http-inspector",
    "api-testing",
    "developer-tools",
    "self-hosted"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "hookline": "src/cli.js"
  },
  "files": [
    "src",
    "public",
    "test",
    "README.md",
    "DEMO.md",
    "CHANGELOG.md",
    "LICENSE",
    "Dockerfile",
    "docker-compose.yml",
    "fly.toml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoIslam-Dev/hookline.git"
  },
  "homepage": "https://github.com/MoIslam-Dev/hookline#readme",
  "bugs": {
    "url": "https://github.com/MoIslam-Dev/hookline/issues"
  },
  "author": "Mo Islam",
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node src/cli.js --dev",
    "test": "node --test"
  },
  "dependencies": {},
  "devDependencies": {}
}
